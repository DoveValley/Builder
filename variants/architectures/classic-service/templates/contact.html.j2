{% extends "base.html.j2" %}
{% block content %}
<section class="cs-hero">
  <div class="cs-hero-inner">
    <h1>Contact {{ site.identity.business }}</h1>
    <p class="cs-hero-subhead">Call, email, or reach us directly — we'll connect you with a local provider fast.</p>
    <a class="cs-btn cs-btn-primary" href="tel:{{ site.identity.tel }}">Call {{ site.identity.phone }}</a>
  </div>
</section>
<section class="cs-service-body">
  <p><strong>Phone:</strong> <a href="tel:{{ site.identity.tel }}">{{ site.identity.phone }}</a></p>
  {% if site.identity.email %}<p><strong>Email:</strong> <a href="mailto:{{ site.identity.email }}">{{ site.identity.email }}</a></p>{% endif %}
  {% if site.identity.address %}<p><strong>Address:</strong> {{ site.identity.address }}</p>{% endif %}
</section>
{% endblock %}
