{% extends "base.html.j2" %}
{% block content %}
<section class="cs-hero cs-hero-service">
  <div class="cs-hero-inner">
    <h1>{{ page.service.name }}{% if page.city %} in {{ page.city.name }}, {{ page.city.SS }}{% endif %}</h1>
    <p class="cs-hero-subhead">{{ page.service.short_desc }}</p>
    <a class="cs-btn cs-btn-primary" href="tel:{{ site.identity.tel }}">Get Help Now</a>
  </div>
</section>

<section class="cs-service-body">
  {{ content.services.get(page.service.id, {}).body_html|default("") }}
</section>

{% if page.city %}
<section class="cs-back-link">
  <a href="/cities/{{ page.city.slug }}/">&larr; All services in {{ page.city.name }}, {{ page.city.SS }}</a>
</section>
{% endif %}
{% endblock %}
