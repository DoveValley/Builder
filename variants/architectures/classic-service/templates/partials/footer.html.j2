<footer class="cs-footer">
  <div class="cs-footer-inner">
    <div class="cs-footer-col">
      <p class="cs-footer-business">{{ site.identity.business }}</p>
      <p>{{ site.identity.address }}</p>
      <p><a href="tel:{{ site.identity.tel }}">{{ site.identity.phone }}</a></p>
      {% if site.identity.email %}<p><a href="mailto:{{ site.identity.email }}">{{ site.identity.email }}</a></p>{% endif %}
    </div>
    <div class="cs-footer-col">
      <p class="cs-footer-heading">Areas We Serve</p>
      {% for city in site.cities %}
      <a href="/cities/{{ city.slug }}/">{{ city.name }}, {{ city.SS }}</a>
      {% endfor %}
    </div>
    <div class="cs-footer-col">
      <p class="cs-footer-heading">Legal</p>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms of Service</a>
      <a href="/disclaimer/">Disclaimer</a>
    </div>
  </div>
  <p class="cs-footer-disclosure">{{ content.legal.disclaimer.referral_line|default(site.niche.business_descriptor) }}</p>
  <p class="cs-footer-copyright">&copy; {{ site.meta.current_year }} {{ site.identity.business }}. All rights reserved.</p>
</footer>
<div class="cs-call-bar">
  <a href="tel:{{ site.identity.tel }}">Call Now: {{ site.identity.phone }}</a>
</div>
