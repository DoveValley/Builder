<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.meta_description }}">
<link rel="canonical" href="{{ page.canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ type.google_fonts_url }}">
<style>
  :root {
    --cs-color-primary: {{ color.primary }};
    --cs-color-primary-dark: {{ color.primary_dark }};
    --cs-color-accent: {{ color.accent }};
    --cs-color-text: {{ color.text }};
    --cs-color-text-muted: {{ color.text_muted }};
    --cs-color-bg: {{ color.bg }};
    --cs-color-bg-alt: {{ color.bg_alt }};
    --cs-color-border: {{ color.border }};
    --cs-font-heading: {{ type.font_heading }};
    --cs-font-body: {{ type.font_body }};
    --cs-scale-ratio: {{ type.scale_ratio }};
    --cs-heading-weight: {{ type.heading_weight }};
    --cs-body-weight: {{ type.body_weight }};
    --cs-line-height-body: {{ type.line_height_body }};
  }
</style>
<link rel="stylesheet" href="/style.css">
{% if page.schema_json %}
<script type="application/ld+json">{{ page.schema_json }}</script>
{% endif %}
