{% extends "base.html.j2" %}
{% block content %}
<section class="cs-hero">
  <div class="cs-hero-inner">
    <h1>{{ content.hero.headline }}</h1>
    <p class="cs-hero-subhead">{{ content.hero.subhead }}</p>
    <a class="cs-btn cs-btn-primary" href="tel:{{ site.identity.tel }}">{{ site.hero.cta_label|default("Get Help Now") }}</a>
  </div>
</section>

<section class="cs-services">
  <h2>Our Services</h2>
  <div class="cs-card-grid">
    {% for svc in site.services["items"] %}
    <a class="cs-card" href="{{ svc.url }}">
      <h3>{{ svc.name }}</h3>
      <p>{{ svc.short_desc }}</p>
    </a>
    {% endfor %}
  </div>
</section>

<section class="cs-cities">
  <h2>Areas We Serve</h2>
  <div class="cs-city-grid">
    {% for city in site.cities %}
    <a class="cs-city-chip" href="/cities/{{ city.slug }}/">{{ city.name }}, {{ city.SS }}</a>
    {% endfor %}
  </div>
</section>

{% if site.faqs %}
<section class="cs-faq">
  <h2>Frequently Asked Questions</h2>
  <div class="cs-accordion">
    {% for faq in site.faqs %}
    {% set f = content.faqs.get(faq.id, {}) %}
    <details class="cs-accordion-item">
      <summary>{{ f.question }}</summary>
      <div>{{ f.answer }}</div>
    </details>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
