{% extends "base.html.j2" %}
{% block content %}
<section class="cs-hero">
  <div class="cs-hero-inner">
    <h1>Page Not Found</h1>
    <p class="cs-hero-subhead">The page you're looking for doesn't exist. Try one of the areas we serve below, or call us directly.</p>
    <a class="cs-btn cs-btn-primary" href="/">Back to Home</a>
  </div>
</section>
<section class="cs-cities">
  <div class="cs-city-grid">
    {% for city in site.cities %}
    <a class="cs-city-chip" href="/cities/{{ city.slug }}/">{{ city.name }}, {{ city.SS }}</a>
    {% endfor %}
  </div>
</section>
{% endblock %}
