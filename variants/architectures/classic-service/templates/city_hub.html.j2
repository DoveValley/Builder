{% extends "base.html.j2" %}
{% block content %}
<section class="cs-hero cs-hero-city">
  <div class="cs-hero-inner">
    <h1>{{ site.niche.service_noun|title }} in {{ page.city.name }}, {{ page.city.SS }}</h1>
    <p class="cs-hero-subhead">{{ content.hero.headline }}</p>
    <a class="cs-btn cs-btn-primary" href="tel:{{ site.identity.tel }}">Get Help Now</a>
  </div>
</section>

{% if page.city.stats %}
<section class="cs-local-stats">
  <h2>{{ page.city.name }} at a Glance</h2>
  <div class="cs-stat-grid">
    {% for stat in page.city.stats %}
    <div class="cs-stat-card">
      {% if stat.chart_image %}<img src="{{ stat.chart_image }}" alt="{{ stat.chart_alt|default(stat.label) }}" loading="lazy">{% endif %}
      <p class="cs-stat-value">{{ stat.value }}{{ stat.unit }}</p>
      <p class="cs-stat-label">{{ stat.label }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if page.city.local_facts %}
<section class="cs-local-facts">
  {% for fact in page.city.local_facts %}
  <p>{{ fact.text }}</p>
  {% endfor %}
</section>
{% endif %}

<section class="cs-services">
  <h2>Services in {{ page.city.name }}, {{ page.city.SS }}</h2>
  <div class="cs-card-grid">
    {% for svc in site.services["items"] %}
    <a class="cs-card" href="{{ svc.url }}">
      <h3>{{ svc.name }}</h3>
      <p>{{ svc.short_desc }}</p>
    </a>
    {% endfor %}
  </div>
</section>

{% set city_guides = site.pages.guides|selectattr("city_id", "equalto", page.city.id)|list %}
{% if city_guides %}
<section class="cs-guides">
  <h2>Local Guides for {{ page.city.name }}</h2>
  <ul class="cs-guide-list">
    {% for g in city_guides %}
    <li><a href="/guides/{{ g.slug }}/">{{ content.guides.get(g.slug, {}).title }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% endblock %}
