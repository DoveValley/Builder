    "niche_table": {
        "title": "What to Expect: Typical Fee Structure by Practice Area",
        "columns": [
            "Practice Area",
            "Typical Fee Structure",
            "What It Means for You"
        ],
        "rows": [
            [
                "Personal Injury",
                "Contingency fee",
                "No fee unless you recover a settlement or award — the firm is paid a percentage of what you receive"
            ],
            [
                "DUI",
                "Flat fee",
                "A single agreed price covers the case through a typical first-offense resolution, so costs are predictable up front"
            ],
            [
                "Criminal Defense",
                "Flat fee (common) or retainer",
                "Many cases are quoted as one price; more complex or ongoing matters may require an hourly retainer"
            ],
            [
                "Family Law",
                "Hourly rate",
                "Billed for actual time spent — cost varies with case complexity and how contested the matter is"
            ],
            [
                "Divorce",
                "Hourly rate",
                "Similar to family law — an uncontested divorce typically costs far less than a contested one"
            ],
            [
                "Traffic Tickets",
                "Flat fee",
                "A simple, predictable price to fight a single citation"
            ],
            [
                "Real Estate Law",
                "Flat fee or hourly",
                "Closings are commonly flat-fee; disputes or litigation are typically billed hourly"
            ],
            [
                "Estate Planning",
                "Flat fee",
                "A fixed price for a standard will, trust, or power-of-attorney package"
            ],
            [
                "Bankruptcy",
                "Flat fee",
                "A fixed price per filing type — Chapter 7 and Chapter 13 are typically priced differently"
            ],
            [
                "Immigration",
                "Flat fee per filing type",
                "Cost is usually quoted per visa or petition type rather than by the hour"
            ],
            [
                "Workers' Compensation",
                "Contingency fee",
                "Like personal injury, paid from your awarded benefits rather than billed upfront"
            ],
            [
                "Employment Law",
                "Hourly or contingency",
                "Workplace disputes are often hourly; claims against an employer may be contingency-based"
            ],
            [
                "Business / Corporate Law",
                "Hourly or monthly retainer",
                "Ongoing counsel is commonly a monthly retainer; one-time matters are billed hourly"
            ],
            [
                "Civil Litigation",
                "Hourly rate",
                "Billed for time spent through discovery, motions, and trial"
            ],
            [
                "Tax Law",
                "Hourly or flat fee",
                "Routine filings are often flat-fee; audits and disputes are typically billed hourly"
            ]
        ],
        "source_topic": null
    },
