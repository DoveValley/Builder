*.log
.DS_Store
*.tmp

# Landing Page Clients — API keys live outside client.json on purpose (same
# reasoning as deploy.json below: a plaintext secret has no business in
# version control even though client.json itself is tracked source).
clients/*/secrets/

# Same reasoning, for agency login passwords — client_agencies/*.json is
# tracked source; the password hash lives in this sibling flat tree instead.
client_agencies_secrets/

# Same reasoning, for the PlusCities rewrite's client API keys —
# pluscities_clients/*.json is tracked source; the key lives in this sibling
# flat tree instead (see config.php's PLUSCITIES_CLIENTS_SECRETS_DIR).
pluscities_clients_secrets/

# A deleted client's record + API secret quarantine (config.php's
# PLUSCITIES_CLIENTS_DELETED_DIR) — contains the same real API key a deleted
# client's secrets file did, same reasoning as pluscities_clients_secrets/.
pluscities_clients_deleted/

# Same soft-delete quarantine pattern, extended 2026-11-26 to niches and
# compliance presets — no secrets in these two, but still a recycle bin, not
# something source control needs to track.
niche_blueprints_deleted/
compliance_presets_deleted/
# Same pattern again, 2026-11-26, for the 2 families folded into home-trades
# during the 6→4 consolidation (hand-rolled quarantine — families have no
# delete feature via the admin panel by design).
niche_families_deleted/

# Same reasoning, for real per-person Agency Editor account passwords —
# pluscities_agency_users/*.json is tracked source; the password hash lives
# in this sibling flat tree instead.
pluscities_agency_users_secrets/

# Google Search Console service account key — real credential, never commit.
config/gsc_service_account.json

# PlusCities client photos/logos: a client's own real upload, and the
# per-client branded cache generated from a niche default (see
# includes/pluscities_images.php) — both disposable and regenerable, same as
# the main engine's uploads/ never being committed wholesale. The niche
# defaults themselves (niche_default_images/) ARE real shared source and
# stay tracked — only this per-client derived/uploaded content is excluded.
pluscities_uploads/branded/
pluscities_uploads/photos/
pluscities_uploads/logos/
# Area Map (includes/pluscities_area_map.php): drawn once per city_id,
# disposable/regenerable from `cities` table + cached OSM tiles/boundaries
# (cache/, already ignored below) — never source of truth.
pluscities_uploads/city_maps/
# Data Chart (includes/pluscities_data_chart.php): same reasoning — drawn
# once per city_id, disposable/regenerable from the census_acs dataset.
pluscities_uploads/data_charts/
# Climate Chart (includes/pluscities_climate_chart.php): same reasoning —
# drawn once per (city_id, chart_id), regenerable from NOAA + the datasets
# table cache.
pluscities_uploads/climate_charts/
# City Info (includes/pluscities_city_info.php): a real Wikipedia photo +
# AI narrative, drawn once per city_id — regenerable from Wikipedia +
# the write step, never source of truth.
pluscities_uploads/city_photos/

# Dedicated SSH key: www-data (this box) -> lpcdelivery (LPC box), scoped to
# syncing the delivery data tree only. Real credential, never commit.
.lpc_delivery_sync_key
.lpc_delivery_sync_key.pub

# HestiaCP access key for the LPC demo-sites box — real credential, never commit.
.lpc_demo_box_api_key.json

# Kinsta management API key, used one-time to migrate the 7 LPC test sites off
# Kinsta onto the LPC demo-sites box. Real credential, never commit.
.kinsta_api_key

# Dedicated SSH key: www-data (this box) -> lpcprovision (LPC demo-sites box),
# scoped to provisioning/managing WordPress content on that box only. Real
# credential, never commit.
.lpc_demo_box_ssh_key
.lpc_demo_box_ssh_key.pub

# FTP credentials — never commit. deploy.json lives at the SITE ROOT (the path
# the code actually reads, ACTIVE_SITE_DIR/deploy.json); the data/ path below is
# kept as a belt-and-suspenders guard for any legacy location.
sites/*/deploy.json
sites/*/data/deploy.json

# Multisite master-level data (holds FTP credentials) — never commit.
# Fail-safe: ignore everything in the dir by default, so nothing added later can
# leak. Written as /* rather than / so git descends and the negation below can
# un-ignore one specific safe file — a rule naming the directory itself cannot be
# un-ignored file by file (same reasoning as uploads/convo and _originals below).
sites/*/multisite/*
# niche_brief.json holds no secrets — niche descriptor, tone, offerings, research
# prompt. pest-template's copy was already tracked; water/mold/appliance's were
# not, purely by omission, which left real config edits with no git history at all.
!sites/*/multisite/niche_brief.json
# archetypes.json (per-master prompt overrides/additions, compiled by
# multisite/ai/compile.php alongside niche_brief.json) is the same story — prompt
# text, no secrets — but had no exception carved out at all, so appliance-site's
# and granitepmacademy's copies existed on disk with zero git history.
!sites/*/multisite/archetypes.json
# image_prompts.json (per-master AI-photo prompt templates, captured automatically from
# Pic Drop — see includes/multisite/image_ai.php) is the same story again: prompt text,
# no secrets, real config that would otherwise have zero git history by the same omission.
!sites/*/multisite/image_prompts.json
# theme_presets.json (per-master Visual Identity library: colors + font + button
# radius + icon per preset) is the same story again: no secrets, real config that
# silently diverged between masters with no git history — appliance-site's copy
# was force-added at some point in the past (has real history), mold-site's never
# was, which is exactly how mold-site's heading_font preset bug went unreviewable.
!sites/*/multisite/theme_presets.json

# Multisite batch data — params.csv carries ftp_pass in plaintext, plus run logs.
# Same fail-safe rule: the whole dir, so nothing added later can leak either.
sites/*/batches/

# Generated static output and the multisite regression baseline — local artifacts, not source.
output/
_multisite_baseline/

# Test Lab scratch uploads (transient, auto-pruned)
uploads/lab/
# The uploads are scratch; the folder's .htaccess is SOURCE and must be tracked.
# It was ignored along with everything else, which split the change that allows
# source files into this web-served folder from the rule that makes them inert:
# the permissive half would ship and the protection would stay on one box.
# Written as /* rather than / so git descends and the negation below applies —
# a rule naming the directory itself cannot be un-ignored file by file.
uploads/convo/*
!uploads/convo/.htaccess
# ...and the same channel in reverse: files left for Scott to read or download.
# Working notes and one-off instructions, not source — the section that lists
# them (admin/playground.php #downloads-scott) IS tracked, the contents are not.
uploads/downloads/

# Test Lab -> build locked hero-overlay style (set per-environment via the UI)
multisite/hero_style.json

# Fleet-wide batch sequence counter -- live runtime state, not config
multisite/batch_seq.json
multisite/.batch_seq.lock

# Structure-generation concurrency lock (flock'd, live runtime state, not config)
data/.generation.lock
sites/*/data/.generation.lock

# cities.json research/geocode concurrency lock (flock'd, live runtime state, not config)
sites/*/data/cities.json.lock

# Generation backups (created by generate.py on each landing regen)
sites/*/data/pages/*.bak

# Ad-hoc data backups (.bak, .bak2, .bak-pest, etc.) left by rework/clone tools
sites/*/data/*.bak
sites/*/data/*.bak[0-9]
sites/*/data/*.bak-*

# Infra config snapshots taken before/after a box add/remove (contain live credentials —
# must never be committed)
admin/infra/config/*.bak-*

# Python bytecode cache
__pycache__/
*.pyc

# Anthropic API key (secret — never commit)
.ai_key

# OpenAI API key (secret — never commit)
.openai_key

# CallTrackingMetrics agency API credentials (secret — never commit)
.ctm_key
.ctm_secret

# Stripe API keys (secret key — never commit; publishable key isn't secret
# but kept alongside it for consistency)
.stripe_secret_key
.stripe_publishable_key
.stripe_webhook_secret

# Test Lab AI-image-generator output — throwaway, paid-API artifacts, not curated examples
admin/_labshots/ai_generated_*
config/plesk.json
admin/infra/state/

# Infra console credentials. Ignore EVERY json in there and re-admit the .example
# files, rather than listing each secret by name: the by-name list silently failed
# to cover config/keywords.json the moment a new provider was added, and the next
# credential file would have been committed the same way.
admin/infra/config/*.json
!admin/infra/config/*.example.json

# Directory Network spreadsheet exports — regenerated by `npm run export:sheets` in the
# directory-network repo, which writes straight into admin/_dirnet-data/. Not committed:
# sheet2-facts.csv is ~141 MB, past GitHub's 100 MB hard file limit, and all of it is
# derived from the production database. dirnet-sheets.php shows a clear "run the export"
# message when they are absent, so a fresh checkout fails loudly rather than silently.
admin/_dirnet-data/sheet1-facilities.csv*
admin/_dirnet-data/sheet2-facts.csv*
admin/_dirnet-data/sheet3-legend.csv

# Claude Code's per-machine permission allowlist. Local state, not project config:
# it records which commands were approved on THIS box, so committing it would push
# one machine's approvals onto every checkout. The shared settings file (without
# .local) is the one that belongs in git, if we ever need one.
.claude/settings.local.json
.claude/settings.local.json.bak-*

# Full-size crop sources kept by Pic Drop so a picture can be re-cropped later.
# Local artifacts, not source: they are never deployed (the build copies only
# uploads/) and are regenerated on the next drop. The folder's .htaccess IS source —
# it is what stops the webroot serving them — so that one is tracked.
sites/*/_originals/*
!sites/*/_originals/.htaccess

# Google Fonts file-preload cache (includes/helpers.php gf_preload_urls()) —
# regenerable lookup of font URLs, not meaningful to version.
data/gf_preload_cache.json

# NOAA/Census retrieval cache (noaa_normals.py) — re-fetchable, never source of truth
/cache/

# Demo Sites panel's theme-info cache (short TTL, regenerable) — not meaningful to version.
.lpc_demo_box_theme_cache.json

# Scott's yes/no verdicts on candidate premium templates — personal review state, not code.
.lpc_template_review.json

# Niche label for a demo site once it's connected to a real domain (can't be derived from
# the domain string the way demo-{niche}.q111.xyz could) — per-environment state, not code.
.lpc_demo_niche_overrides.json

# WP Builder's site registry — the inputs each built site was created from, not code.
.wp_builder_sites.json
.pluscities_cf_token
.pluscities_cf_zone.json
.pluscities_turnstile.json

# Platform Information's "Who's Logged In" session registry — live runtime state
# (who's online right now, login history), rewritten on every authenticated
# request. Not meaningful to version, and it carries real IPs/session ids.
.platform_login_sessions.json

# Quarantined (soft-deleted) Landing Page Clients — lpc_delete_client() moves
# clients/{id}/ here wholesale, secrets/api_key.txt included, so this needs
# the same never-commit treatment as clients/*/secrets/ above.
clients_deleted/
