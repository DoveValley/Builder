*.log
.DS_Store
*.tmp

# FTP credentials — never commit. deploy.json lives at the SITE ROOT (the path
# the code actually reads, ACTIVE_SITE_DIR/deploy.json); the data/ path below is
# kept as a belt-and-suspenders guard for any legacy location.
sites/*/deploy.json
sites/*/data/deploy.json

# Multisite master-level data (holds FTP credentials) — never commit.
# Ignore the whole dir: fail-safe, so no future file inside can ever leak.
sites/*/multisite/

# Multisite batch data — params.csv carries ftp_pass in plaintext, plus run logs.
# Same fail-safe rule: the whole dir, so nothing added later can leak either.
sites/*/batches/

# Generated static output and the multisite regression baseline — local artifacts, not source.
output/
_multisite_baseline/

# Test Lab scratch uploads (transient, auto-pruned)
uploads/lab/
# The uploads are scratch; the folder's .htaccess is SOURCE and must be tracked.
# It was ignored along with everything else, which split the change that allows
# source files into this web-served folder from the rule that makes them inert:
# the permissive half would ship and the protection would stay on one box.
# Written as /* rather than / so git descends and the negation below applies —
# a rule naming the directory itself cannot be un-ignored file by file.
uploads/convo/*
!uploads/convo/.htaccess
# ...and the same channel in reverse: files left for Scott to read or download.
# Working notes and one-off instructions, not source — the section that lists
# them (admin/playground.php #downloads-scott) IS tracked, the contents are not.
uploads/downloads/

# Test Lab -> build locked hero-overlay style (set per-environment via the UI)
multisite/hero_style.json

# Fleet-wide batch sequence counter -- live runtime state, not config
multisite/batch_seq.json
multisite/.batch_seq.lock

# Generation backups (created by generate.py on each landing regen)
sites/*/data/pages/*.bak

# Ad-hoc data backups (.bak, .bak2, .bak-pest, etc.) left by rework/clone tools
sites/*/data/*.bak
sites/*/data/*.bak[0-9]
sites/*/data/*.bak-*

# Python bytecode cache
__pycache__/
*.pyc

# Anthropic API key (secret — never commit)
.ai_key
config/plesk.json
admin/infra/state/

# Infra console credentials. Ignore EVERY json in there and re-admit the .example
# files, rather than listing each secret by name: the by-name list silently failed
# to cover config/keywords.json the moment a new provider was added, and the next
# credential file would have been committed the same way.
admin/infra/config/*.json
!admin/infra/config/*.example.json

# Directory Network spreadsheet exports — regenerated by `npm run export:sheets` in the
# directory-network repo, which writes straight into admin/_dirnet-data/. Not committed:
# sheet2-facts.csv is ~141 MB, past GitHub's 100 MB hard file limit, and all of it is
# derived from the production database. dirnet-sheets.php shows a clear "run the export"
# message when they are absent, so a fresh checkout fails loudly rather than silently.
admin/_dirnet-data/sheet1-facilities.csv*
admin/_dirnet-data/sheet2-facts.csv*
admin/_dirnet-data/sheet3-legend.csv

# Claude Code's per-machine permission allowlist. Local state, not project config:
# it records which commands were approved on THIS box, so committing it would push
# one machine's approvals onto every checkout. The shared settings file (without
# .local) is the one that belongs in git, if we ever need one.
.claude/settings.local.json
.claude/settings.local.json.bak-*

# Full-size crop sources kept by Pic Drop so a picture can be re-cropped later.
# Local artifacts, not source: they are never deployed (the build copies only
# uploads/) and are regenerated on the next drop. The folder's .htaccess IS source —
# it is what stops the webroot serving them — so that one is tracked.
sites/*/_originals/*
!sites/*/_originals/.htaccess
